{
  "name": "@tree-weaver/branches",
  "version": "0.1.0",
  "description": "The Tree Weaver branch library: ready-made layout and content branches, and tree templates.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tree-weaver/core": "workspace:*"
  }
}
