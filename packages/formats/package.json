{
  "name": "@tree-weaver/formats",
  "version": "0.1.0",
  "description": "Import and export Tree Weaver forests and trees as JSON, YAML, XML, HTML and Markdown.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tree-weaver/core": "workspace:*",
    "htmlparser2": "^12.0.0",
    "domhandler": "^6.0.1",
    "marked": "^18.1.1",
    "yaml": "^2.9.1"
  }
}
