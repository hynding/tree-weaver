{
  "name": "@tree-weaver/mcp",
  "version": "0.1.0",
  "description": "MCP server for Tree Weaver: lets AI agents create, patch, validate, render and screenshot layout trees.",
  "license": "MIT",
  "keywords": [
    "tree-weaver",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "layout",
    "page-builder"
  ],
  "homepage": "https://github.com/hynding/tree-weaver/blob/main/docs/mcp.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hynding/tree-weaver.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/hynding/tree-weaver/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tree-weaver-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/esm-extensions.mjs dist && node ../../scripts/chmod-bin.mjs dist/bin.js && node ../../scripts/copy-docs.mjs dist/docs format.md shorthand.md patch.md export.md",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/copy-license.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tree-weaver/branches": "workspace:*",
    "@tree-weaver/core": "workspace:*",
    "@tree-weaver/formats": "workspace:*",
    "@tree-weaver/kits": "workspace:*",
    "zod": "^4.1.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
